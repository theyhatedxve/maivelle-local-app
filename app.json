{
  "expo": {
    "name": "Maivelle",
    "slug": "maivelle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/brand/maivelle-app-icon.png",
    "backgroundColor": "#F8F5FF",
    "scheme": "maivelle",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.maivelle.app",
      "allowBackup": false,
      "icon": "./assets/images/brand/maivelle-app-icon.png",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/brand/maivelle-app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F5FF",
          "image": "./assets/images/brand/maivelle-logo.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#171122"
          }
        }
      ],
      "expo-sharing",
      "expo-image"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "e251f00b-1744-4d50-afc7-588e8a712092"
      }
    },
    "owner": "devdb01"
  }
}
